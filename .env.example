# App
# Development example only. Never copy placeholder credentials to production.
APP_NAME=Farm Net
APP_ENV=development
APP_DEBUG=false
APP_VERSION=0.26.0-dev.1

# Auth Dev
# Must be false in staging/production.
AUTH_DEV_OTP_ENABLED=true
AUTH_DEV_OTP_CODE=111111

# URLs
PUBLIC_BASE_URL=http://localhost:8000
ADMIN_BASE_URL=http://localhost:8080
MEDIA_BASE_URL=http://localhost:8000/media

# Backend
API_V1_PREFIX=/api/v1

# Database
MYSQL_HOST=mysql
MYSQL_PORT=3306
MYSQL_HOST_PORT=3307
MYSQL_DATABASE=farmnet_db
MYSQL_USER=farmnet_user
MYSQL_PASSWORD=change-me
DATABASE_URL=mysql+pymysql://farmnet_user:change-me@mysql:3306/farmnet_db
# Production alternative: DATABASE_URL_FILE=/run/secrets/database_url

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_HOST_PORT=6380
REDIS_DB=0
REDIS_URL=redis://redis:6379/0
# Production alternative: REDIS_URL_FILE=/run/secrets/redis_url

# Barzegar Retrieval
QDRANT_URL=http://qdrant:6333
QDRANT_API_KEY=
# Production alternative: QDRANT_API_KEY_FILE=/run/secrets/qdrant_api_key
QDRANT_TIMEOUT_SECONDS=10

# JWT
JWT_SECRET_KEY=change-me
# Production alternative: JWT_SECRET_KEY_FILE=/run/secrets/jwt_secret_key
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=30

# Super Admin Bootstrap
SUPER_ADMIN_EMAIL=admin@example.com
SUPER_ADMIN_PHONE=09120000000
SUPER_ADMIN_PASSWORD=change-me
# Production alternative: SUPER_ADMIN_PASSWORD_FILE=/run/secrets/super_admin_password

# OTP
OTP_EXPIRE_MINUTES=2
OTP_MAX_ATTEMPTS=5
OTP_RATE_LIMIT_SECONDS=60

# SMS
SMS_ENABLED=false
SMS_PROVIDER=http_json
SMS_API_URL=
SMS_API_KEY=
SMS_SENDER=
SMS_TIMEOUT_SECONDS=15

# Email
EMAIL_ENABLED=false
EMAIL_PROVIDER=smtp
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASSWORD=
EMAIL_FROM=
EMAIL_STARTTLS=true
EMAIL_USE_SSL=false
EMAIL_TIMEOUT_SECONDS=15

# Push
PUSH_ENABLED=false
PUSH_PROVIDER=http_json
PUSH_API_URL=
PUSH_API_KEY=
PUSH_TIMEOUT_SECONDS=15

# Payment
PAYMENT_GATEWAY_ENABLED=false
PAYMENT_GATEWAY=zarinpal
PAYMENT_MERCHANT_ID=
PAYMENT_CALLBACK_BASE_URL=http://localhost:8000/api/v1/payments/callback/zarinpal
PAYMENT_ZARINPAL_SANDBOX=true
PAYMENT_GATEWAY_TIMEOUT_SECONDS=15

# Storage
STORAGE_DRIVER=local
# Must be an absolute persistent path in staging/production.
MEDIA_STORAGE_DIR=/app/storage/media
MAX_UPLOAD_SIZE_MB=10

# Security
CORS_ORIGINS=http://localhost:3000,http://localhost:8080,http://localhost:8081
RATE_LIMIT_ENABLED=true
# Use redis in staging/production. Memory is development-only.
RATE_LIMIT_BACKEND=memory
RATE_LIMIT_REQUESTS=120
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_MAX_KEYS=10000
SEARCH_RATE_LIMIT_REQUESTS=30
SEARCH_RATE_LIMIT_WINDOW_SECONDS=60
AUTH_RATE_LIMIT_REQUESTS=10
AUTH_RATE_LIMIT_WINDOW_SECONDS=60
# Only immediate reverse-proxy IPs listed here may supply X-Forwarded-For.
TRUSTED_PROXY_HOSTS=

# Logging
LOG_LEVEL=INFO

# Barzegar AI provider (server-side only; never expose this key to Mobile/Admin)
AI_PROVIDER_ENABLED=false
AI_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_TIMEOUT_SECONDS=60
