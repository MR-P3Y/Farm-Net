    {"name": "Lessor - Create equipment", "request": {"method": "POST", "header": [{"key": "Authorization", "value": "Bearer {{access_token}}"}, {"key": "Content-Type", "value": "application/json"}], "body": {"mode": "raw", "raw": "{\n  \"category_id\": {{rental_category_id}},\n  \"title\": \"تراکتور اجاره‌ای\",\n  \"slug\": \"rental-tractor\",\n  \"description\": \"تجهیز آماده اجاره\",\n  \"operator_mode\": \"either\",\n  \"province_id\": 1,\n  \"city_id\": 1,\n  \"address_text\": \"محل تحویل\",\n  \"media_items\": [{\"media_file_id\": {{media_file_id}}, \"is_primary\": true}]\n}"}, "url": "{{base_url}}/rentals/me/equipment"}},
    {"name": "Lessor - Update equipment", "request": {"method": "PUT", "header": [{"key": "Authorization", "value": "Bearer {{access_token}}"}, {"key": "Content-Type", "value": "application/json"}], "body": {"mode": "raw", "raw": "{\n  \"category_id\": {{rental_category_id}},\n  \"title\": \"تراکتور اجاره‌ای\",\n  \"slug\": \"rental-tractor\",\n  \"description\": \"تجهیز آماده اجاره\",\n  \"operator_mode\": \"either\",\n  \"province_id\": 1,\n  \"city_id\": 1,\n  \"address_text\": \"محل تحویل\",\n  \"media_items\": [{\"media_file_id\": {{media_file_id}}, \"is_primary\": true}]\n}"}, "url": "{{base_url}}/rentals/me/equipment/{{rental_equipment_id}}"}},
    {"name": "Lessor - Submit equipment", "request": {"method": "POST", "header": [{"key": "Authorization", "value": "Bearer {{access_token}}"}], "url": "{{base_url}}/rentals/me/equipment/{{rental_equipment_id}}/submit"}},
