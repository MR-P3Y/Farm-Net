{
  "info": {
    "name": "Farm-Net Equipment Rental",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {"key": "base_url", "value": "http://localhost:8000/api/v1"},
    {"key": "access_token", "value": ""},
    {"key": "rental_category_id", "value": "1"},
    {"key": "lessor_profile_id", "value": "1"}
  ],
  "item": [
    {"name": "Public - List rental categories", "request": {"method": "GET", "url": "{{base_url}}/rentals/categories"}},
    {"name": "Lessor - Get my profile", "request": {"method": "GET", "header": [{"key": "Authorization", "value": "Bearer {{access_token}}"}], "url": "{{base_url}}/rentals/me/lessor-profile"}},
    {"name": "Lessor - Save my profile", "request": {"method": "PUT", "header": [{"key": "Authorization", "value": "Bearer {{access_token}}"}, {"key": "Content-Type", "value": "application/json"}], "body": {"mode": "raw", "raw": "{\n  \"display_name\": \"موجر نمونه\",\n  \"phone\": \"09120000000\",\n  \"province_id\": 1,\n  \"city_id\": 1,\n  \"address_text\": \"نشانی محل تجهیزات\"\n}"}, "url": "{{base_url}}/rentals/me/lessor-profile"}},
    {"name": "Lessor - Submit my profile", "request": {"method": "POST", "header": [{"key": "Authorization", "value": "Bearer {{access_token}}"}], "url": "{{base_url}}/rentals/me/lessor-profile/submit"}},
    {"name": "Admin - List rental categories", "request": {"method": "GET", "header": [{"key": "Authorization", "value": "Bearer {{access_token}}"}], "url": "{{base_url}}/admin/rentals/categories"}},
    {"name": "Admin - Create rental category", "request": {"method": "POST", "header": [{"key": "Authorization", "value": "Bearer {{access_token}}"}, {"key": "Content-Type", "value": "application/json"}], "body": {"mode": "raw", "raw": "{\n  \"code\": \"other_equipment\",\n  \"title\": \"سایر تجهیزات\",\n  \"sort_order\": 900\n}"}, "url": "{{base_url}}/admin/rentals/categories"}},
    {"name": "Admin - Update rental category", "request": {"method": "PATCH", "header": [{"key": "Authorization", "value": "Bearer {{access_token}}"}, {"key": "Content-Type", "value": "application/json"}], "body": {"mode": "raw", "raw": "{\n  \"is_active\": true\n}"}, "url": "{{base_url}}/admin/rentals/categories/{{rental_category_id}}"}},
    {"name": "Admin - List lessor profiles", "request": {"method": "GET", "header": [{"key": "Authorization", "value": "Bearer {{access_token}}"}], "url": "{{base_url}}/admin/rentals/lessor-profiles"}},
    {"name": "Admin - Moderate lessor profile", "request": {"method": "PATCH", "header": [{"key": "Authorization", "value": "Bearer {{access_token}}"}, {"key": "Content-Type", "value": "application/json"}], "body": {"mode": "raw", "raw": "{\n  \"status\": \"approved\",\n  \"admin_note\": null\n}"}, "url": "{{base_url}}/admin/rentals/lessor-profiles/{{lessor_profile_id}}/status"}}
  ]
}
