{
  "info": {
    "name": "Farm Net - Unified Search",
    "description": "Phase 18.11 Unified Search: six public domains, normalized filters, privacy headers, and negative contract regression. Read-only; no search history is stored.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {"key": "base_url", "value": "http://localhost:8000/api/v1"}
  ],
  "item": [
    {
      "name": "Search - All six public domains",
      "request": {
        "method": "POST",
        "header": [{"key": "Content-Type", "value": "application/json"}],
        "body": {"mode": "raw", "raw": "{\n  \"q\": \"خدمات كشاورزي\",\n  \"sort\": \"relevance\",\n  \"page\": 1,\n  \"page_size\": 5\n}"},
        "url": "{{base_url}}/search"
      },
      "event": [{
        "listen": "test",
        "script": {"type": "text/javascript", "exec": [
          "pm.test('200 and privacy headers', function () { pm.response.to.have.status(200); pm.expect(pm.response.headers.get('Cache-Control')).to.eql('no-store'); pm.expect(pm.response.headers.get('X-Robots-Tag')).to.eql('noindex, nofollow'); });",
          "pm.test('all groups preserve order', function () { const data = pm.response.json().data; pm.expect(data.query).to.eql('خدمات کشاورزی'); pm.expect(data.groups.map(g => g.type)).to.eql(['product','store','service','rental_equipment','consultant','social_post']); });"
        ]}
      }]
    },
    {
      "name": "Search - Products only",
      "request": {"method": "POST", "header": [{"key": "Content-Type", "value": "application/json"}], "body": {"mode": "raw", "raw": "{\n  \"q\": \"بذر گندم\",\n  \"types\": [\"product\"],\n  \"sort\": \"price_asc\"\n}"}, "url": "{{base_url}}/search"}
    },
    {
      "name": "Search - Stores only",
      "request": {"method": "POST", "header": [{"key": "Content-Type", "value": "application/json"}], "body": {"mode": "raw", "raw": "{\n  \"q\": \"فروشگاه کشاورزی\",\n  \"types\": [\"store\"],\n  \"sort\": \"newest\"\n}"}, "url": "{{base_url}}/search"}
    },
    {
      "name": "Search - Services only",
      "request": {"method": "POST", "header": [{"key": "Content-Type", "value": "application/json"}], "body": {"mode": "raw", "raw": "{\n  \"q\": \"آزمایش خاک\",\n  \"types\": [\"service\"],\n  \"filters\": {\"service_pricing_type\": \"fixed\", \"currency\": \"TOMAN\"},\n  \"sort\": \"rating\"\n}"}, "url": "{{base_url}}/search"}
    },
    {
      "name": "Search - Rental availability",
      "request": {"method": "POST", "header": [{"key": "Content-Type", "value": "application/json"}], "body": {"mode": "raw", "raw": "{\n  \"q\": \"کمباین\",\n  \"types\": [\"rental_equipment\"],\n  \"filters\": {\n    \"rental_operator_mode\": \"either\",\n    \"rental_available_from\": \"2026-08-01T00:00:00Z\",\n    \"rental_available_to\": \"2026-08-02T00:00:00Z\",\n    \"currency\": \"TOMAN\"\n  }\n}"}, "url": "{{base_url}}/search"}
    },
    {
      "name": "Search - Consultants only",
      "request": {"method": "POST", "header": [{"key": "Content-Type", "value": "application/json"}], "body": {"mode": "raw", "raw": "{\n  \"q\": \"گیاه پزشک\",\n  \"types\": [\"consultant\"],\n  \"filters\": {\"consultant_specialty_id\": 1},\n  \"sort\": \"rating\"\n}"}, "url": "{{base_url}}/search"}
    },
    {
      "name": "Search - Social posts only",
      "request": {"method": "POST", "header": [{"key": "Content-Type", "value": "application/json"}], "body": {"mode": "raw", "raw": "{\n  \"q\": \"آفت گندم\",\n  \"types\": [\"social_post\"],\n  \"filters\": {\"social_post_type\": \"guide\"},\n  \"sort\": \"relevance\"\n}"}, "url": "{{base_url}}/search"}
    },
    {
      "name": "Search - Selected domains geo and TOMAN price",
      "request": {"method": "POST", "header": [{"key": "Content-Type", "value": "application/json"}], "body": {"mode": "raw", "raw": "{\n  \"q\": \"تراکتور\",\n  \"types\": [\"product\", \"rental_equipment\", \"service\"],\n  \"filters\": {\n    \"province_id\": 1,\n    \"city_id\": 1,\n    \"min_price\": 0,\n    \"max_price\": 50000000,\n    \"currency\": \"TOMAN\"\n  },\n  \"sort\": \"price_asc\"\n}"}, "url": "{{base_url}}/search"}
    },
    {
      "name": "Search - Reject duplicate types (422)",
      "request": {"method": "POST", "header": [{"key": "Content-Type", "value": "application/json"}], "body": {"mode": "raw", "raw": "{\n  \"q\": \"کود\",\n  \"types\": [\"product\", \"product\"]\n}"}, "url": "{{base_url}}/search"},
      "event": [{"listen": "test", "script": {"type": "text/javascript", "exec": ["pm.test('duplicate types rejected', function () { pm.response.to.have.status(422); });"]}}]
    },
    {
      "name": "Search - Reject non-TOMAN (422)",
      "request": {"method": "POST", "header": [{"key": "Content-Type", "value": "application/json"}], "body": {"mode": "raw", "raw": "{\n  \"q\": \"کود\",\n  \"filters\": {\"currency\": \"IRR\"}\n}"}, "url": "{{base_url}}/search"},
      "event": [{"listen": "test", "script": {"type": "text/javascript", "exec": ["pm.test('non-TOMAN rejected', function () { pm.response.to.have.status(422); });"]}}]
    },
    {
      "name": "Search - Reject response budget (422)",
      "request": {"method": "POST", "header": [{"key": "Content-Type", "value": "application/json"}], "body": {"mode": "raw", "raw": "{\n  \"q\": \"کود\",\n  \"types\": [\"product\", \"store\", \"service\"],\n  \"page_size\": 50\n}"}, "url": "{{base_url}}/search"},
      "event": [{"listen": "test", "script": {"type": "text/javascript", "exec": ["pm.test('response budget rejected', function () { pm.response.to.have.status(422); });"]}}]
    },
    {
      "name": "Search - Reject incomplete Rental interval (422)",
      "request": {"method": "POST", "header": [{"key": "Content-Type", "value": "application/json"}], "body": {"mode": "raw", "raw": "{\n  \"q\": \"کمباین\",\n  \"types\": [\"rental_equipment\"],\n  \"filters\": {\"rental_available_from\": \"2026-08-01T00:00:00Z\"}\n}"}, "url": "{{base_url}}/search"},
      "event": [{"listen": "test", "script": {"type": "text/javascript", "exec": ["pm.test('incomplete interval rejected', function () { pm.response.to.have.status(422); });"]}}]
    }
  ]
}
