{
  "info": {
    "name": "Farm Net - Orders Payments Commission Foundation",
    "_postman_id": "48d02b90-9f11-4bb8-9bfb-orders-payments-commission",
    "description": "Phase 9 Orders/Payments plus Phase 20 Ledger, settlement, adjustment, and disabled-by-default Zarinpal IRT adapter/callback contracts. Real gateway use requires explicit credentials and activation.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "base_url", "value": "http://localhost:8000/api/v1" },
    { "key": "access_token", "value": "" },
    { "key": "admin_access_token", "value": "" },
    { "key": "product_id", "value": "1" },
    { "key": "cart_item_id", "value": "1" },
    { "key": "order_id", "value": "1" },
    { "key": "payment_id", "value": "1" },
    { "key": "invoice_id", "value": "1" },
    { "key": "payment_attempt_id", "value": "1" },
    { "key": "refund_id", "value": "1" },
    { "key": "settlement_id", "value": "1" },
    { "key": "zarinpal_authority", "value": "S000000000000000000000000000000000001" }
  ],
  "item": [
    {
      "name": "Auth - User Login",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "url": "{{base_url}}/auth/login/email",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"test-auth@example.com\",\n  \"password\": \"Test@123456\"\n}"
        }
      }
    },
    {
      "name": "Auth - Admin Login",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "url": "{{base_url}}/auth/login/email",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"admin@example.com\",\n  \"password\": \"change-me\"\n}"
        }
      }
    },
    {
      "name": "Cart - Get My Cart",
      "request": {
        "auth": {
          "type": "bearer",
          "bearer": [{ "key": "token", "value": "{{access_token}}", "type": "string" }]
        },
        "method": "GET",
        "url": "{{base_url}}/cart/me"
      }
    },
    {
      "name": "Cart - Add Item",
      "request": {
        "auth": {
          "type": "bearer",
          "bearer": [{ "key": "token", "value": "{{access_token}}", "type": "string" }]
        },
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "url": "{{base_url}}/cart/items",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"product_id\": 1,\n  \"quantity\": 1\n}"
        }
      }
    },
    {
      "name": "Cart - Update Item",
      "request": {
        "auth": {
          "type": "bearer",
          "bearer": [{ "key": "token", "value": "{{access_token}}", "type": "string" }]
        },
        "method": "PATCH",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "url": "{{base_url}}/cart/items/{{cart_item_id}}",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"quantity\": 3\n}"
        }
      }
    },
    {
      "name": "Cart - Delete Item",
      "request": {
        "auth": {
          "type": "bearer",
          "bearer": [{ "key": "token", "value": "{{access_token}}", "type": "string" }]
        },
        "method": "DELETE",
        "url": "{{base_url}}/cart/items/{{cart_item_id}}"
      }
    },
    {
      "name": "Cart - Clear",
      "request": {
        "auth": {
          "type": "bearer",
          "bearer": [{ "key": "token", "value": "{{access_token}}", "type": "string" }]
        },
        "method": "DELETE",
        "url": "{{base_url}}/cart/clear"
      }
    },
    {
      "name": "Checkout - Create Orders",
      "request": {
        "auth": {
          "type": "bearer",
          "bearer": [{ "key": "token", "value": "{{access_token}}", "type": "string" }]
        },
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "url": "{{base_url}}/checkout",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"idempotency_key\": \"postman-checkout-{{$timestamp}}\",\n  \"buyer_note\": \"Postman checkout\",\n  \"shipping_address\": \"Test address\",\n  \"shipping_postal_code\": \"1234567890\",\n  \"shipping_phone\": \"09120000000\"\n}"
        }
      }
    },
    {
      "name": "Buyer Orders - List My Orders",
      "request": {
        "auth": {
          "type": "bearer",
          "bearer": [{ "key": "token", "value": "{{access_token}}", "type": "string" }]
        },
        "method": "GET",
        "url": "{{base_url}}/orders/me"
      }
    },
    {
      "name": "Buyer Orders - Get My Order",
      "request": {
        "auth": {
          "type": "bearer",
          "bearer": [{ "key": "token", "value": "{{access_token}}", "type": "string" }]
        },
        "method": "GET",
        "url": "{{base_url}}/orders/{{order_id}}"
      }
    },
    {
      "name": "Payments - List My Payments",
      "request": {
        "auth": {
          "type": "bearer",
          "bearer": [{ "key": "token", "value": "{{access_token}}", "type": "string" }]
        },
        "method": "GET",
        "url": "{{base_url}}/payments/me"
      }
    },
    {
      "name": "Payments - Get Payment",
      "request": {
        "auth": {
          "type": "bearer",
          "bearer": [{ "key": "token", "value": "{{access_token}}", "type": "string" }]
        },
        "method": "GET",
        "url": "{{base_url}}/payments/{{payment_id}}"
      }
    },
    {
      "name": "Payments - Mock Pay",
      "request": {
        "auth": {
          "type": "bearer",
          "bearer": [{ "key": "token", "value": "{{access_token}}", "type": "string" }]
        },
        "method": "POST",
        "url": "{{base_url}}/payments/{{payment_id}}/mock/pay"
      }
    },
    {
      "name": "Payments - Mock Fail",
      "request": {
        "auth": {
          "type": "bearer",
          "bearer": [{ "key": "token", "value": "{{access_token}}", "type": "string" }]
        },
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "url": "{{base_url}}/payments/{{payment_id}}/mock/fail",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"reason\": \"Mock fail from Postman\"\n}"
        }
      }
    },
    {
      "name": "Seller Orders - List",
      "request": {
        "auth": {
          "type": "bearer",
          "bearer": [{ "key": "token", "value": "{{admin_access_token}}", "type": "string" }]
        },
        "method": "GET",
        "url": "{{base_url}}/seller/orders"
      }
    },
    {
      "name": "Seller Orders - Detail",
      "request": {
        "auth": {
          "type": "bearer",
          "bearer": [{ "key": "token", "value": "{{admin_access_token}}", "type": "string" }]
        },
        "method": "GET",
        "url": "{{base_url}}/seller/orders/{{order_id}}"
      }
    },
    {
      "name": "Seller Orders - Update Status",
      "request": {
        "auth": {
          "type": "bearer",
          "bearer": [{ "key": "token", "value": "{{admin_access_token}}", "type": "string" }]
        },
        "method": "PATCH",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "url": "{{base_url}}/seller/orders/{{order_id}}/status",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"status\": \"confirmed\",\n  \"seller_note\": \"Seller confirmed from Postman\"\n}"
        }
      }
    },
    {
      "name": "Admin Orders - List",
      "request": {
        "auth": {
          "type": "bearer",
          "bearer": [{ "key": "token", "value": "{{admin_access_token}}", "type": "string" }]
        },
        "method": "GET",
        "url": "{{base_url}}/admin/orders?page=1&page_size=20"
      }
    },
    {
      "name": "Admin Orders - Detail",
      "request": {
        "auth": {
          "type": "bearer",
          "bearer": [{ "key": "token", "value": "{{admin_access_token}}", "type": "string" }]
        },
        "method": "GET",
        "url": "{{base_url}}/admin/orders/{{order_id}}"
      }
    },
    {
      "name": "Admin Orders - Cancel",
      "request": {
        "auth": {
          "type": "bearer",
          "bearer": [{ "key": "token", "value": "{{admin_access_token}}", "type": "string" }]
        },
        "method": "PATCH",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "url": "{{base_url}}/admin/orders/{{order_id}}/status",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"status\": \"cancelled\",\n  \"admin_note\": \"Admin cancelled from Postman\"\n}"
        }
      }
    },
    {
      "name": "Admin Orders - Refund",
      "request": {
        "auth": {
          "type": "bearer",
          "bearer": [{ "key": "token", "value": "{{admin_access_token}}", "type": "string" }]
        },
        "method": "PATCH",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "url": "{{base_url}}/admin/orders/{{order_id}}/status",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"status\": \"refunded\",\n  \"admin_note\": \"Admin refunded from Postman\"\n}"
        }
      }
    },
    {
      "name": "Admin Commission - List Settings",
      "request": {
        "auth": {
          "type": "bearer",
          "bearer": [{ "key": "token", "value": "{{admin_access_token}}", "type": "string" }]
        },
        "method": "GET",
        "url": "{{base_url}}/admin/commission/settings"
      }
    },
    {
      "name": "Admin Commission - Get Default",
      "request": {
        "auth": {
          "type": "bearer",
          "bearer": [{ "key": "token", "value": "{{admin_access_token}}", "type": "string" }]
        },
        "method": "GET",
        "url": "{{base_url}}/admin/commission/settings/default"
      }
    },
    {
      "name": "Admin Commission - Update Default",
      "request": {
        "auth": {
          "type": "bearer",
          "bearer": [{ "key": "token", "value": "{{admin_access_token}}", "type": "string" }]
        },
        "method": "PATCH",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "url": "{{base_url}}/admin/commission/settings/default",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"percent\": 5.00,\n  \"description\": \"Default commission used for new orders. Admin can change it later.\"\n}"
        }
      }
    },
    {
      "name": "Payments - Initiate Idempotent",
      "request": {"auth":{"type":"bearer","bearer":[{"key":"token","value":"{{access_token}}","type":"string"}]},"method":"POST","header":[{"key":"Content-Type","value":"application/json"}],"url":"{{base_url}}/payments/checkout","body":{"mode":"raw","raw":"{\n  \"invoice_id\": {{invoice_id}},\n  \"provider\": \"mock\",\n  \"idempotency_key\": \"postman-payment-{{invoice_id}}\"\n}"}}
    },
    {
      "name": "Payments - Verify Exact Once",
      "request": {"auth":{"type":"bearer","bearer":[{"key":"token","value":"{{access_token}}","type":"string"}]},"method":"POST","header":[{"key":"Content-Type","value":"application/json"}],"url":"{{base_url}}/payments/verify","body":{"mode":"raw","raw":"{\n  \"payment_attempt_id\": {{payment_attempt_id}},\n  \"provider_payment_id\": \"MOCK-{{payment_attempt_id}}\"\n}"}}
    },
    {
      "name": "Admin Refunds - Request Full Refund",
      "request": {"auth":{"type":"bearer","bearer":[{"key":"token","value":"{{admin_access_token}}","type":"string"}]},"method":"POST","header":[{"key":"Content-Type","value":"application/json"}],"url":"{{base_url}}/admin/orders/refunds","body":{"mode":"raw","raw":"{\n  \"invoice_id\": {{invoice_id}},\n  \"amount\": 1000,\n  \"reason\": \"Postman full refund\",\n  \"idempotency_key\": \"postman-refund-{{invoice_id}}\"\n}"}}
    },
    {
      "name": "Admin Refunds - Complete Mock",
      "request": {"auth":{"type":"bearer","bearer":[{"key":"token","value":"{{admin_access_token}}","type":"string"}]},"method":"POST","header":[{"key":"Content-Type","value":"application/json"}],"url":"{{base_url}}/admin/orders/refunds/{{refund_id}}/complete","body":{"mode":"raw","raw":"{\n  \"provider_reference\": \"MOCK-REFUND-{{refund_id}}\"\n}"}}
    },
    {"name":"Admin Finance - Invoices","request":{"auth":{"type":"bearer","bearer":[{"key":"token","value":"{{admin_access_token}}","type":"string"}]},"method":"GET","url":"{{base_url}}/admin/finance/invoices?page=1&page_size=20"}},
    {"name":"Admin Finance - Invoice Detail","request":{"auth":{"type":"bearer","bearer":[{"key":"token","value":"{{admin_access_token}}","type":"string"}]},"method":"GET","url":"{{base_url}}/admin/finance/invoices/{{invoice_id}}"}},
    {"name":"Admin Finance - Payment Attempts","request":{"auth":{"type":"bearer","bearer":[{"key":"token","value":"{{admin_access_token}}","type":"string"}]},"method":"GET","url":"{{base_url}}/admin/finance/payment-attempts?page=1&page_size=20"}},
    {"name":"Admin Finance - Transactions","request":{"auth":{"type":"bearer","bearer":[{"key":"token","value":"{{admin_access_token}}","type":"string"}]},"method":"GET","url":"{{base_url}}/admin/finance/transactions?page=1&page_size=20"}},
    {"name":"Admin Finance - Refunds","request":{"auth":{"type":"bearer","bearer":[{"key":"token","value":"{{admin_access_token}}","type":"string"}]},"method":"GET","url":"{{base_url}}/admin/finance/refunds?page=1&page_size=20"}},
    {"name":"Admin Finance - Audit Logs","request":{"auth":{"type":"bearer","bearer":[{"key":"token","value":"{{admin_access_token}}","type":"string"}]},"method":"GET","url":"{{base_url}}/admin/finance/audit-logs?page=1&page_size=20"}},
    {"name":"Admin Finance - Ledger Reconciliation","request":{"auth":{"type":"bearer","bearer":[{"key":"token","value":"{{admin_access_token}}","type":"string"}]},"method":"GET","url":"{{base_url}}/admin/finance/reconciliation"}},
    {"name":"Wallet - Own Balances","request":{"auth":{"type":"bearer","bearer":[{"key":"token","value":"{{access_token}}","type":"string"}]},"method":"GET","url":"{{base_url}}/finance/wallet/me"}},
    {"name":"Settlement - Own List","request":{"auth":{"type":"bearer","bearer":[{"key":"token","value":"{{access_token}}","type":"string"}]},"method":"GET","url":"{{base_url}}/finance/settlements/me?page=1&page_size=20"}},
    {"name":"Settlement - Request Idempotent","request":{"auth":{"type":"bearer","bearer":[{"key":"token","value":"{{access_token}}","type":"string"}]},"method":"POST","header":[{"key":"Content-Type","value":"application/json"}],"url":"{{base_url}}/finance/settlements","body":{"mode":"raw","raw":"{\n  \"amount\": 100000,\n  \"currency\": \"TOMAN\",\n  \"idempotency_key\": \"postman-settlement-0001\",\n  \"note\": \"Test settlement request\"\n}"}}},
    {"name":"Admin Settlement - List","request":{"auth":{"type":"bearer","bearer":[{"key":"token","value":"{{admin_access_token}}","type":"string"}]},"method":"GET","url":"{{base_url}}/admin/finance/settlements?page=1&page_size=20"}},
    {"name":"Admin Settlement - Approve","request":{"auth":{"type":"bearer","bearer":[{"key":"token","value":"{{admin_access_token}}","type":"string"}]},"method":"PATCH","header":[{"key":"Content-Type","value":"application/json"}],"url":"{{base_url}}/admin/finance/settlements/{{settlement_id}}/decision","body":{"mode":"raw","raw":"{\n  \"decision\": \"approve\",\n  \"admin_note\": \"Approved for simulated clearing\"\n}"}}},
    {"name":"Admin Settlement - Simulate Payout","request":{"auth":{"type":"bearer","bearer":[{"key":"token","value":"{{admin_access_token}}","type":"string"}]},"method":"POST","url":"{{base_url}}/admin/finance/settlements/{{settlement_id}}/simulate-payout","description":"Moves reserved liability to payout clearing only. It does not execute or claim a bank transfer."}},
    {"name":"Admin Finance - Provider Wallet Adjustment","request":{"auth":{"type":"bearer","bearer":[{"key":"token","value":"{{admin_access_token}}","type":"string"}]},"method":"POST","header":[{"key":"Content-Type","value":"application/json"}],"url":"{{base_url}}/admin/finance/adjustments","body":{"mode":"raw","raw":"{\n  \"provider_user_id\": 1,\n  \"amount\": 10000,\n  \"direction\": \"credit\",\n  \"currency\": \"TOMAN\",\n  \"idempotency_key\": \"postman-adjustment-0001\",\n  \"reason\": \"Approved accounting correction for provider wallet\"\n}"},"description":"Posts an idempotent, balanced, audited TOMAN adjustment. Debit adjustments cannot overdraw available balance."}},
    {"name":"Payments - Zarinpal Checkout","request":{"auth":{"type":"bearer","bearer":[{"key":"token","value":"{{access_token}}","type":"string"}]},"method":"POST","header":[{"key":"Content-Type","value":"application/json"}],"url":"{{base_url}}/payments/checkout","body":{"mode":"raw","raw":"{\n  \"invoice_id\": {{invoice_id}},\n  \"provider\": \"zarinpal\",\n  \"idempotency_key\": \"postman-zarinpal-0001\"\n}"},"description":"Requires PAYMENT_GATEWAY_ENABLED=true and a valid Merchant ID. Sends amount as IRT (toman)."}},
    {"name":"Payments - Zarinpal Callback OK","request":{"method":"GET","url":"{{base_url}}/payments/callback/zarinpal?Authority={{zarinpal_authority}}&Status=OK","description":"Public return endpoint. Status=OK is never trusted alone; backend performs server-to-server Verify before marking paid."}},
    {"name":"Finance - My Invoices","request":{"auth":{"type":"bearer","bearer":[{"key":"token","value":"{{access_token}}","type":"string"}]},"method":"GET","url":"{{base_url}}/finance/invoices/me?page=1&page_size=20","description":"Payer-owned invoice list; provider/platform economics are excluded."}},
    {"name":"Finance - My Invoice Detail","request":{"auth":{"type":"bearer","bearer":[{"key":"token","value":"{{access_token}}","type":"string"}]},"method":"GET","url":"{{base_url}}/finance/invoices/me/{{invoice_id}}","description":"Returns only an invoice owned by the authenticated payer."}}
  ]
}
