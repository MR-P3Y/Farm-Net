{
  "info": {
    "name": "Farm Net - Consultants",
    "description": "Consultants module APIs: public specialties and consultant profiles, privacy contract, user consultant profile management, consultation request flow, assigned consultant workbench, and admin moderation. Public consultant responses must not expose phone, email, or admin_note.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:8000/api/v1"
    },
    {
      "key": "access_token",
      "value": ""
    },
    {
      "key": "specialty_id",
      "value": "1"
    },
    {
      "key": "consultant_profile_id",
      "value": "1"
    },
    {
      "key": "consult_request_id",
      "value": "1"
    },
    {
      "key": "admin_access_token",
      "value": ""
    },
    {
      "key": "consultant_user_access_token",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Public - List Specialties",
      "request": {
        "method": "GET",
        "url": "{{base_url}}/consultants/specialties"
      }
    },
    {
      "name": "Public - List Consultants",
      "request": {
        "method": "GET",
        "url": "{{base_url}}/consultants?page=1&page_size=20&specialty_id={{specialty_id}}"
      }
    },
    {
      "name": "Public - Consultant Detail",
      "request": {
        "method": "GET",
        "url": "{{base_url}}/consultants/{{consultant_profile_id}}"
      }
    },
    {
      "name": "Public - Consultant Privacy Contract",
      "request": {
        "method": "GET",
        "url": "{{base_url}}/consultants/{{consultant_profile_id}}",
        "description": "Public consultant detail must not expose phone, email, or admin_note. Owner/admin fields are only available from /me or admin endpoints."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('public consultant hides owner/admin fields', function () {",
              "  const json = pm.response.json();",
              "  const data = json.data || {};",
              "  pm.expect(data).to.not.have.property('phone');",
              "  pm.expect(data).to.not.have.property('email');",
              "  pm.expect(data).to.not.have.property('admin_note');",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "User - Upsert My Consultant Profile",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{access_token}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"display_name\": \"مشاور پسته کرمان\",\n  \"title\": \"متخصص آفات و تغذیه پسته\",\n  \"bio\": \"مشاوره تخصصی باغ پسته، تغذیه، آفات و بیماری‌ها.\",\n  \"experience_years\": 8,\n  \"phone\": \"09120000000\",\n  \"province_name\": \"کرمان\",\n  \"city_name\": \"رفسنجان\",\n  \"specialty_ids\": [{{specialty_id}}]\n}"
        },
        "url": "{{base_url}}/consultants/me/profile"
      }
    },
    {
      "name": "User - Submit My Consultant Profile",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{access_token}}"
          }
        ],
        "url": "{{base_url}}/consultants/me/profile/submit"
      }
    },
    {
      "name": "User - Create Consult Request",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{access_token}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"consultant_profile_id\": {{consultant_profile_id}},\n  \"specialty_id\": {{specialty_id}},\n  \"title\": \"مشکل زردی برگ پسته\",\n  \"description\": \"درختان پسته از دو هفته قبل زردی برگ و ضعف رشد دارند. نیاز به بررسی تخصصی دارم.\",\n  \"contact_method\": \"in_app\",\n  \"budget_amount\": 2500000,\n  \"currency\": \"IRR\"\n}"
        },
        "url": "{{base_url}}/consultants/requests"
      }
    },
    {
      "name": "User - My Consult Requests",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{access_token}}"
          }
        ],
        "url": "{{base_url}}/consultants/requests/me"
      }
    },
    {
      "name": "User - Cancel Consult Request",
      "request": {
        "method": "PATCH",
        "url": "{{base_url}}/consultants/requests/{{consult_request_id}}/cancel",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{access_token}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"status\": \"cancelled\",\n  \"note\": \"لغو تستی از Postman\"\n}"
        },
        "description": "Requires consult_requests.manage_own. Performs soft status cancellation for the requester."
      }
    },
    {
      "name": "Consultant - Assigned Requests",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{consultant_user_access_token}}"
          }
        ],
        "url": "{{base_url}}/consultants/requests/assigned"
      }
    },
    {
      "name": "Consultant - Assigned Requests Filtered",
      "request": {
        "method": "GET",
        "url": "{{base_url}}/consultants/requests/assigned?status=open&page=1&page_size=20",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{consultant_user_access_token}}"
          }
        ],
        "description": "Requires consultant role permission consult_requests.manage_assigned and an approved consultant profile."
      }
    },
    {
      "name": "Consultant - Accept Assigned Request",
      "request": {
        "method": "PATCH",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{consultant_user_access_token}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"status\": \"accepted\",\n  \"note\": \"درخواست بررسی شد و زمان مشاوره هماهنگ می‌شود.\"\n}"
        },
        "url": "{{base_url}}/consultants/requests/{{consult_request_id}}/status"
      }
    },
    {
      "name": "Consultant - Reject Assigned Request",
      "request": {
        "method": "PATCH",
        "url": "{{base_url}}/consultants/requests/{{consult_request_id}}/status",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{consultant_user_access_token}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"status\": \"rejected\",\n  \"note\": \"امکان پذیرش این درخواست وجود ندارد.\"\n}"
        },
        "description": "Valid consultant transition from open to rejected."
      }
    },
    {
      "name": "Consultant - Start Assigned Request",
      "request": {
        "method": "PATCH",
        "url": "{{base_url}}/consultants/requests/{{consult_request_id}}/status",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{consultant_user_access_token}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"status\": \"in_progress\",\n  \"note\": \"مشاوره شروع شد.\"\n}"
        },
        "description": "Valid consultant transition from accepted to in_progress."
      }
    },
    {
      "name": "Consultant - Complete Assigned Request",
      "request": {
        "method": "PATCH",
        "url": "{{base_url}}/consultants/requests/{{consult_request_id}}/status",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{consultant_user_access_token}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"status\": \"completed\",\n  \"note\": \"مشاوره تکمیل شد.\"\n}"
        },
        "description": "Valid consultant transition from in_progress to completed."
      }
    },
    {
      "name": "Consultant - Cancel Assigned Request",
      "request": {
        "method": "PATCH",
        "url": "{{base_url}}/consultants/requests/{{consult_request_id}}/status",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{consultant_user_access_token}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"status\": \"cancelled\",\n  \"note\": \"مشاوره از سمت مشاور لغو شد.\"\n}"
        },
        "description": "Valid consultant transition from accepted or in_progress to cancelled."
      }
    },
    {
      "name": "Admin - Create Specialty",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{admin_access_token}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"code\": \"pistachio_disease\",\n  \"title\": \"آفات و بیماری پسته\",\n  \"description\": \"مشاوره تخصصی آفات، بیماری و تغذیه پسته\",\n  \"sort_order\": 100,\n  \"is_active\": true\n}"
        },
        "url": "{{base_url}}/admin/consultants/specialties"
      }
    },
    {
      "name": "Admin - List Consultant Profiles",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{admin_access_token}}"
          }
        ],
        "url": "{{base_url}}/admin/consultants?status=pending_review"
      }
    },
    {
      "name": "Admin - Approve Consultant Profile",
      "request": {
        "method": "PATCH",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{admin_access_token}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"status\": \"approved\",\n  \"note\": \"مدارک و تخصص تأیید شد.\"\n}"
        },
        "url": "{{base_url}}/admin/consultants/{{consultant_profile_id}}/status"
      }
    },
    {
      "name": "Admin - Reject Consultant Profile",
      "request": {
        "method": "PATCH",
        "url": "{{base_url}}/admin/consultants/{{consultant_profile_id}}/status",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{admin_access_token}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"status\": \"rejected\",\n  \"note\": \"پروفایل نیاز به اصلاح دارد.\"\n}"
        },
        "description": "Requires consultants.reject."
      }
    },
    {
      "name": "Admin - Suspend Consultant Profile",
      "request": {
        "method": "PATCH",
        "url": "{{base_url}}/admin/consultants/{{consultant_profile_id}}/status",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{admin_access_token}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"status\": \"suspended\",\n  \"note\": \"تعلیق تستی پروفایل مشاور.\"\n}"
        },
        "description": "Requires consultants.suspend."
      }
    },
    {
      "name": "Admin - List Consult Requests",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{admin_access_token}}"
          }
        ],
        "url": "{{base_url}}/admin/consultants/requests?status=open"
      }
    },
    {
      "name": "Admin - Update Consult Request Status",
      "request": {
        "method": "PATCH",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{admin_access_token}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"status\": \"completed\",\n  \"note\": \"درخواست از سمت مدیریت تکمیل شد.\"\n}"
        },
        "url": "{{base_url}}/admin/consultants/requests/{{consult_request_id}}/status"
      }
    },
    {
      "name": "User - Create My Consultant Profile",
      "request": {
        "method": "POST",
        "url": "{{base_url}}/consultants/me/profile",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{access_token}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"display_name\": \"مشاور نمونه فارم نت\",\n  \"title\": \"متخصص تغذیه گیاه\",\n  \"bio\": \"پروفایل نمونه برای تست جریان مشاور.\",\n  \"experience_years\": 5,\n  \"phone\": \"09120000000\",\n  \"email\": \"consultant@example.com\",\n  \"province_name\": \"تهران\",\n  \"city_name\": \"تهران\",\n  \"avatar_file_id\": null,\n  \"avatar_media_file_id\": null,\n  \"specialty_ids\": [\n    \"{{specialty_id}}\"\n  ]\n}"
        },
        "description": "Creates the current user's consultant profile. Use PUT to update the same profile."
      }
    },
    {
      "name": "User - Get My Consultant Profile",
      "request": {
        "method": "GET",
        "url": "{{base_url}}/consultants/me/profile",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{access_token}}"
          }
        ]
      }
    },
    {
      "name": "Admin - List Specialties",
      "request": {
        "method": "GET",
        "url": "{{base_url}}/admin/consultants/specialties",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{admin_access_token}}"
          }
        ]
      }
    },
    {
      "name": "Admin - Update Specialty",
      "request": {
        "method": "PATCH",
        "url": "{{base_url}}/admin/consultants/specialties/{{specialty_id}}",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{admin_access_token}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"نمونه ویرایش‌شده\",\n  \"is_active\": true\n}"
        }
      }
    },
    {
      "name": "Admin - Consultant Detail",
      "request": {
        "method": "GET",
        "url": "{{base_url}}/admin/consultants/{{consultant_profile_id}}",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{admin_access_token}}"
          }
        ]
      }
    }
  ]
}
