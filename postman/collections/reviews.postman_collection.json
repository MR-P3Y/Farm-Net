{
  "info": {
    "name": "Farm-Net Marketplace Reviews",
    "description": "Phase 19 marketplace Reviews: owner CRUD, public active-only reads, canonical atomic rating aggregates, governed reports, typed Admin moderation, and immutable audit logs. Eligibility is server-authoritative and requires a real delivered/completed source.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {"key": "base_url", "value": "http://localhost:8000/api/v1"},
    {"key": "access_token", "value": ""},
    {"key": "review_source_type", "value": "service_request"},
    {"key": "review_source_id", "value": "1"},
    {"key": "review_subject_type", "value": "service_provider"},
    {"key": "review_subject_id", "value": "1"},
    {"key": "review_id", "value": "1"},
    {"key": "review_report_id", "value": "1"}
  ],
  "item": [
    {
      "name": "List public Reviews and rating summary",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{base_url}}/reviews/subjects/{{review_subject_type}}/{{review_subject_id}}?page=1&page_size=20"
      }
    },
    {
      "name": "Create eligible Review",
      "request": {
        "method": "POST",
        "header": [
          {"key": "Authorization", "value": "Bearer {{access_token}}"},
          {"key": "Content-Type", "value": "application/json"}
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"source_type\": \"{{review_source_type}}\",\n  \"source_id\": {{review_source_id}},\n  \"subject_type\": \"{{review_subject_type}}\",\n  \"subject_id\": {{review_subject_id}},\n  \"score\": 5,\n  \"body\": \"تجربه‌ای دقیق و رضایت‌بخش\"\n}"
        },
        "url": "{{base_url}}/reviews"
      }
    },
    {
      "name": "List my Reviews",
      "request": {
        "method": "GET",
        "header": [{"key": "Authorization", "value": "Bearer {{access_token}}"}],
        "url": "{{base_url}}/reviews/me?page=1&page_size=20"
      }
    },
    {
      "name": "Get my Review",
      "request": {
        "method": "GET",
        "header": [{"key": "Authorization", "value": "Bearer {{access_token}}"}],
        "url": "{{base_url}}/reviews/me/{{review_id}}"
      }
    },
    {
      "name": "Update my active Review",
      "request": {
        "method": "PATCH",
        "header": [
          {"key": "Authorization", "value": "Bearer {{access_token}}"},
          {"key": "Content-Type", "value": "application/json"}
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"score\": 4,\n  \"body\": \"متن ویرایش‌شده نظر\"\n}"
        },
        "url": "{{base_url}}/reviews/me/{{review_id}}"
      }
    },
    {
      "name": "Delete my Review",
      "request": {
        "method": "DELETE",
        "header": [{"key": "Authorization", "value": "Bearer {{access_token}}"}],
        "url": "{{base_url}}/reviews/me/{{review_id}}"
      }
    },
    {
      "name": "Report a public Review",
      "request": {
        "method": "POST",
        "header": [
          {"key": "Authorization", "value": "Bearer {{access_token}}"},
          {"key": "Content-Type", "value": "application/json"}
        ],
        "body": {"mode": "raw", "raw": "{\n  \"reason\": \"spam\",\n  \"description\": \"محتوای تکراری یا تبلیغاتی\"\n}"},
        "url": "{{base_url}}/reviews/{{review_id}}/reports"
      }
    },
    {
      "name": "Admin list Reviews",
      "request": {
        "method": "GET",
        "header": [{"key": "Authorization", "value": "Bearer {{access_token}}"}],
        "url": "{{base_url}}/admin/reviews?page=1&page_size=20"
      }
    },
    {
      "name": "Admin moderate Review",
      "request": {
        "method": "PATCH",
        "header": [
          {"key": "Authorization", "value": "Bearer {{access_token}}"},
          {"key": "Content-Type", "value": "application/json"}
        ],
        "body": {"mode": "raw", "raw": "{\n  \"status\": \"hidden\",\n  \"note\": \"نیازمند بررسی حریم خصوصی\"\n}"},
        "url": "{{base_url}}/admin/reviews/{{review_id}}/status"
      }
    },
    {
      "name": "Admin Review moderation logs",
      "request": {
        "method": "GET",
        "header": [{"key": "Authorization", "value": "Bearer {{access_token}}"}],
        "url": "{{base_url}}/admin/reviews/{{review_id}}/moderation-logs"
      }
    },
    {
      "name": "Admin list Review reports",
      "request": {
        "method": "GET",
        "header": [{"key": "Authorization", "value": "Bearer {{access_token}}"}],
        "url": "{{base_url}}/admin/reviews/reports?status=open&page=1&page_size=20"
      }
    },
    {
      "name": "Admin resolve Review report",
      "request": {
        "method": "PATCH",
        "header": [
          {"key": "Authorization", "value": "Bearer {{access_token}}"},
          {"key": "Content-Type", "value": "application/json"}
        ],
        "body": {"mode": "raw", "raw": "{\n  \"status\": \"resolved\",\n  \"resolution_note\": \"گزارش بررسی و تأیید شد\"\n}"},
        "url": "{{base_url}}/admin/reviews/reports/{{review_report_id}}/status"
      }
    }
  ]
}
