{
  "info": {
    "_postman_id": "d4e1c1c1-a228-4c21-9533-175000000005",
    "name": "Farm-Net Services Request Flow",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "base_url", "value": "http://localhost:8000/api/v1" },
    { "key": "requester_token", "value": "" },
    { "key": "provider_token", "value": "" },
    { "key": "admin_token", "value": "" },
    { "key": "category_id", "value": "1" },
    { "key": "provider_profile_id", "value": "1" },
    { "key": "offer_id", "value": "1" },
    { "key": "service_request_id", "value": "1" },
    { "key": "billing_invoice_id", "value": "1" },
    { "key": "billing_payment_attempt_id", "value": "1" },
    { "key": "billing_refund_id", "value": "1" }
  ],
  "item": [
    {
      "name": "Public discovery",
      "item": [
        { "name": "List categories", "request": { "method": "GET", "header": [], "url": "{{base_url}}/services/categories?q=" } },
        { "name": "List approved offers", "request": { "method": "GET", "header": [], "url": "{{base_url}}/services/offers?page=1&page_size=20&category_id={{category_id}}&q=%D9%83%D8%B4%D8%A7%D9%88%D8%B1%D8%B2%D9%8A&min_price=0&max_price=999999999&sort=relevance" } },
        { "name": "Nearby approved offers", "request": { "method": "GET", "header": [], "url": "{{base_url}}/services/offers?page=1&page_size=20&sort=distance&latitude=35.6892&longitude=51.3890&radius_km=100" } },
        { "name": "Offer public detail", "request": { "method": "GET", "header": [], "url": "{{base_url}}/services/offers/{{offer_id}}" } }
      ]
    },
    {
      "name": "Provider profile and offers",
      "item": [
        { "name": "Get my provider profile", "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{provider_token}}" }], "url": "{{base_url}}/services/me/provider-profile" } },
        {
          "name": "Create or save provider profile",
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{provider_token}}" }, { "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"display_name\": \"Farm-Net Provider\",\n  \"title\": \"Agricultural services provider\",\n  \"bio\": \"Field services and farm support\",\n  \"experience_years\": 5,\n  \"accepting_requests\": true,\n  \"availability_status\": \"available\",\n  \"typical_response_minutes\": 60,\n  \"category_ids\": [{{category_id}}]\n}" },
            "url": "{{base_url}}/services/me/provider-profile"
          }
        },
        {
          "name": "Update provider profile",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Authorization", "value": "Bearer {{provider_token}}" }, { "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"display_name\": \"Farm-Net Provider\",\n  \"service_area\": \"Local farms\",\n  \"accepting_requests\": true,\n  \"availability_status\": \"busy\",\n  \"typical_response_minutes\": 120,\n  \"category_ids\": [{{category_id}}]\n}" },
            "url": "{{base_url}}/services/me/provider-profile"
          }
        },
        { "name": "Submit provider profile", "request": { "method": "POST", "header": [{ "key": "Authorization", "value": "Bearer {{provider_token}}" }], "url": "{{base_url}}/services/me/provider-profile/submit" } },
        { "name": "List my offers", "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{provider_token}}" }], "url": "{{base_url}}/services/me/offers?page=1&page_size=20" } },
        {
          "name": "Create offer",
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{provider_token}}" }, { "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"category_id\": {{category_id}},\n  \"title\": \"Soil testing\",\n  \"slug\": \"soil-testing-postman\",\n  \"description\": \"Professional agricultural soil testing\",\n  \"pricing_type\": \"fixed\",\n  \"price_amount\": 100000,\n  \"currency\": \"TOMAN\",\n  \"media_items\": []\n}" },
            "url": "{{base_url}}/services/me/offers"
          }
        },
        {
          "name": "Update offer",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Authorization", "value": "Bearer {{provider_token}}" }, { "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"title\": \"Updated soil testing\",\n  \"pricing_type\": \"negotiable\"\n}" },
            "url": "{{base_url}}/services/me/offers/{{offer_id}}"
          }
        },
        { "name": "Submit offer", "request": { "method": "POST", "header": [{ "key": "Authorization", "value": "Bearer {{provider_token}}" }], "url": "{{base_url}}/services/me/offers/{{offer_id}}/submit" } }
      ]
    },
    {
      "name": "Requester",
      "item": [
        {
          "name": "Create request",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{requester_token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"offer_id\": {{offer_id}},\n  \"title\": \"Soil test request\",\n  \"description\": \"Please test this field before planting.\",\n  \"contact_method\": \"in_app\",\n  \"currency\": \"TOMAN\"\n}"
            },
            "url": "{{base_url}}/services/requests"
          }
        },
        {
          "name": "List own requests",
          "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{requester_token}}" }], "url": "{{base_url}}/services/requests/me" }
        },
        {
          "name": "Own request detail",
          "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{requester_token}}" }], "url": "{{base_url}}/services/requests/{{service_request_id}}" }
        },
        {
          "name": "Cancel own request",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Authorization", "value": "Bearer {{requester_token}}" }, { "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"reason\": \"No longer required\"\n}" },
            "url": "{{base_url}}/services/requests/{{service_request_id}}/cancel"
          }
        },
        {
          "name": "Get own final price",
          "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{requester_token}}" }], "url": "{{base_url}}/services/requests/{{service_request_id}}/final-price" }
        },
        {
          "name": "Accept own final price",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Authorization", "value": "Bearer {{requester_token}}" }, { "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"decision\": \"accept\"\n}" },
            "url": "{{base_url}}/services/requests/{{service_request_id}}/final-price",
            "description": "Only the requester may accept or reject. Acceptance fails closed until an active default service_request commission policy exists."
          }
        },
        {
          "name": "Checkout final-price invoice",
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{requester_token}}" }, { "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"provider\": \"mock\",\n  \"idempotency_key\": \"postman-service-payment-1\"\n}" },
            "url": "{{base_url}}/finance/invoices/{{billing_invoice_id}}/checkout",
            "description": "Use mock only outside production. Copy id from the accepted final-price invoice_id field into billing_invoice_id."
          }
        },
        {
          "name": "Verify final-price invoice payment",
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{requester_token}}" }, { "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"attempt_id\": {{billing_payment_attempt_id}},\n  \"provider_token\": \"postman-approved\"\n}" },
            "url": "{{base_url}}/finance/payments/verify",
            "description": "For local test flow, copy the checkout response id into billing_payment_attempt_id."
          }
        },
        {
          "name": "Request full service refund",
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{requester_token}}" }, { "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"reason\": \"Service cancellation requested\",\n  \"idempotency_key\": \"postman-service-refund-1\"\n}" },
            "url": "{{base_url}}/services/requests/{{service_request_id}}/refund",
            "description": "Before in_progress the full refund is pre-approved; after work starts it requires Admin review. Copy the returned id into billing_refund_id."
          }
        },
        {
          "name": "Confirm completed service and release funds",
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{requester_token}}" }],
            "url": "{{base_url}}/services/requests/{{service_request_id}}/confirm-completion",
            "description": "Only after status completed. Releases provider pending balance exactly once; no automatic timeout release exists."
          }
        }
      ]
    },
    {
      "name": "Provider",
      "item": [
        {
          "name": "List assigned requests",
          "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{provider_token}}" }], "url": "{{base_url}}/services/requests/assigned" }
        },
        {
          "name": "Assigned request detail",
          "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{provider_token}}" }], "url": "{{base_url}}/services/requests/assigned/{{service_request_id}}" }
        },
        {
          "name": "Update assigned status",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Authorization", "value": "Bearer {{provider_token}}" }, { "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"status\": \"accepted\",\n  \"note\": \"Accepted by provider\"\n}" },
            "url": "{{base_url}}/services/requests/{{service_request_id}}/status"
          }
        },
        {
          "name": "Propose assigned final price",
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{provider_token}}" }, { "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"amount\": 1500000,\n  \"currency\": \"TOMAN\",\n  \"description\": \"Final agreed service scope\"\n}" },
            "url": "{{base_url}}/services/requests/assigned/{{service_request_id}}/final-price"
          }
        },
        {
          "name": "Get assigned final price",
          "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{provider_token}}" }], "url": "{{base_url}}/services/requests/assigned/{{service_request_id}}/final-price" }
        }
      ]
    },
    {
      "name": "Admin",
      "item": [
        { "name": "List categories", "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{admin_token}}" }], "url": "{{base_url}}/admin/services/categories" } },
        {
          "name": "Create category",
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{admin_token}}" }, { "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"code\": \"postman-service\",\n  \"title\": \"Postman service category\",\n  \"sort_order\": 100,\n  \"is_active\": true\n}" },
            "url": "{{base_url}}/admin/services/categories"
          }
        },
        {
          "name": "Update category",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Authorization", "value": "Bearer {{admin_token}}" }, { "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"parent_id\": null,\n  \"title\": \"Updated service category\",\n  \"is_active\": true\n}" },
            "url": "{{base_url}}/admin/services/categories/{{category_id}}"
          }
        },
        { "name": "List provider profiles", "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{admin_token}}" }], "url": "{{base_url}}/admin/services/provider-profiles?page=1&page_size=20" } },
        { "name": "Provider profile detail", "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{admin_token}}" }], "url": "{{base_url}}/admin/services/provider-profiles/{{provider_profile_id}}" } },
        {
          "name": "Moderate provider profile",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Authorization", "value": "Bearer {{admin_token}}" }, { "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"status\": \"approved\",\n  \"note\": \"Approved by admin\"\n}" },
            "url": "{{base_url}}/admin/services/provider-profiles/{{provider_profile_id}}/status"
          }
        },
        { "name": "List offers", "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{admin_token}}" }], "url": "{{base_url}}/admin/services/offers?page=1&page_size=20" } },
        { "name": "Offer detail", "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{admin_token}}" }], "url": "{{base_url}}/admin/services/offers/{{offer_id}}" } },
        {
          "name": "Moderate offer",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Authorization", "value": "Bearer {{admin_token}}" }, { "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"status\": \"approved\",\n  \"note\": \"Approved by admin\"\n}" },
            "url": "{{base_url}}/admin/services/offers/{{offer_id}}/status"
          }
        },
        {
          "name": "List requests",
          "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{admin_token}}" }], "url": "{{base_url}}/admin/services/requests" }
        },
        {
          "name": "Request detail",
          "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{admin_token}}" }], "url": "{{base_url}}/admin/services/requests/{{service_request_id}}" }
        },
        {
          "name": "Update request status",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Authorization", "value": "Bearer {{admin_token}}" }, { "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"status\": \"cancelled\",\n  \"note\": \"Cancelled by admin\"\n}" },
            "url": "{{base_url}}/admin/services/requests/{{service_request_id}}/status"
          }
        },
        {
          "name": "Admin completion confirmation override",
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{admin_token}}" }],
            "url": "{{base_url}}/admin/services/requests/{{service_request_id}}/confirm-completion"
          }
        },
        {
          "name": "List domain commission policies",
          "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{admin_token}}" }], "url": "{{base_url}}/admin/commission/policies" }
        },
        {
          "name": "Get Services commission",
          "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{admin_token}}" }], "url": "{{base_url}}/admin/commission/policies/service_request/default" }
        },
        {
          "name": "Update Services commission",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Authorization", "value": "Bearer {{admin_token}}" }, { "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"percent\": 10.00\n}" },
            "url": "{{base_url}}/admin/commission/policies/service_request/default"
          }
        },
        {
          "name": "List billing refunds",
          "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{admin_token}}" }], "url": "{{base_url}}/admin/finance/billing-refunds?page=1&page_size=20" }
        },
        {
          "name": "Approve reviewed billing refund",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Authorization", "value": "Bearer {{admin_token}}" }, { "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"decision\": \"approve\",\n  \"admin_note\": \"Approved after service review\"\n}" },
            "url": "{{base_url}}/admin/finance/billing-refunds/{{billing_refund_id}}/decision"
          }
        },
        {
          "name": "Complete Mock billing refund",
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{admin_token}}" }, { "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"provider_reference\": \"postman-service-refund-complete-1\"\n}" },
            "url": "{{base_url}}/admin/finance/billing-refunds/{{billing_refund_id}}/complete-mock",
            "description": "Non-production Mock flow only; no real gateway refund is performed."
          }
        }
      ]
    }
  ]
}
