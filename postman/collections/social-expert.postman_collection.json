{
  "info": {
    "name": "Farm Net - Social Expert Answers",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Postman coverage for social post detail expert_answers, public/expert answer APIs, admin expert moderation, and notification visibility checks."
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:8000/api/v1"
    },
    {
      "key": "access_token",
      "value": ""
    },
    {
      "key": "expert_access_token",
      "value": ""
    },
    {
      "key": "admin_access_token",
      "value": ""
    },
    {
      "key": "post_id",
      "value": "1"
    },
    {
      "key": "answer_id",
      "value": "1"
    },
    {
      "key": "expert_user_id",
      "value": "1"
    },
    {
      "key": "post_owner_user_id",
      "value": "1"
    }
  ],
  "item": [
    {
      "name": "Public - List Social Posts",
      "request": {
        "method": "GET",
        "url": "{{base_url}}/social/posts?page=1&page_size=20"
      }
    },
    {
      "name": "Public - Social Post Detail With Expert Answers",
      "request": {
        "method": "GET",
        "url": "{{base_url}}/social/posts/{{post_id}}",
        "description": "Detail response may include expert_answers. Social list responses do not include this field."
      }
    },
    {
      "name": "Public - List Published Expert Answers For Post",
      "request": {
        "method": "GET",
        "url": "{{base_url}}/social/posts/{{post_id}}/expert-answers?page=1&page_size=20",
        "description": "Returns published expert answers only. Hidden/deleted answers are filtered by backend."
      }
    },
    {
      "name": "Expert - Create Answer",
      "request": {
        "method": "POST",
        "url": "{{base_url}}/social/posts/{{post_id}}/expert-answers",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{expert_access_token}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"body\": \"پاسخ تخصصی نمونه برای پست اجتماعی.\"\n}"
        },
        "description": "Requires expert_answer.create. Emits expert_answer_created notification when published and recipient differs from actor."
      }
    },
    {
      "name": "Expert - My Answers",
      "request": {
        "method": "GET",
        "url": "{{base_url}}/expert/me/answers?page=1&page_size=20",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{expert_access_token}}"
          }
        ]
      }
    },
    {
      "name": "Expert - My Answers Filter Published",
      "request": {
        "method": "GET",
        "url": "{{base_url}}/expert/me/answers?status=published&page=1&page_size=20",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{expert_access_token}}"
          }
        ]
      }
    },
    {
      "name": "Expert - Delete Own Answer",
      "request": {
        "method": "DELETE",
        "url": "{{base_url}}/expert/answers/{{answer_id}}",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{expert_access_token}}"
          }
        ]
      }
    },
    {
      "name": "Admin Expert - List Answers",
      "request": {
        "method": "GET",
        "url": "{{base_url}}/admin/expert/answers?page=1&page_size=20",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{admin_access_token}}"
          }
        ]
      }
    },
    {
      "name": "Admin Expert - Filter Published",
      "request": {
        "method": "GET",
        "url": "{{base_url}}/admin/expert/answers?status=published&page=1&page_size=20",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{admin_access_token}}"
          }
        ]
      }
    },
    {
      "name": "Admin Expert - Filter Hidden",
      "request": {
        "method": "GET",
        "url": "{{base_url}}/admin/expert/answers?status=hidden&page=1&page_size=20",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{admin_access_token}}"
          }
        ]
      }
    },
    {
      "name": "Admin Expert - Filter Deleted",
      "request": {
        "method": "GET",
        "url": "{{base_url}}/admin/expert/answers?status=deleted&page=1&page_size=20",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{admin_access_token}}"
          }
        ]
      }
    },
    {
      "name": "Admin Expert - Filter By Post",
      "request": {
        "method": "GET",
        "url": "{{base_url}}/admin/expert/answers?post_id={{post_id}}&page=1&page_size=20",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{admin_access_token}}"
          }
        ]
      }
    },
    {
      "name": "Admin Expert - Filter By Expert",
      "request": {
        "method": "GET",
        "url": "{{base_url}}/admin/expert/answers?expert_id={{expert_user_id}}&page=1&page_size=20",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{admin_access_token}}"
          }
        ],
        "description": "The API query parameter is expert_id and maps to expert_user_id in the response."
      }
    },
    {
      "name": "Admin Expert - Hide Answer",
      "request": {
        "method": "PATCH",
        "url": "{{base_url}}/admin/expert/answers/{{answer_id}}/status",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{admin_access_token}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"status\": \"hidden\"\n}"
        }
      }
    },
    {
      "name": "Admin Expert - Publish Answer",
      "request": {
        "method": "PATCH",
        "url": "{{base_url}}/admin/expert/answers/{{answer_id}}/status",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{admin_access_token}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"status\": \"published\"\n}"
        }
      }
    },
    {
      "name": "Admin Expert - Delete Answer",
      "request": {
        "method": "DELETE",
        "url": "{{base_url}}/admin/expert/answers/{{answer_id}}",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{admin_access_token}}"
          }
        ]
      }
    },
    {
      "name": "Notifications - My Expert Answer Notifications",
      "request": {
        "method": "GET",
        "url": "{{base_url}}/notifications/me?page=1&page_size=20&channel=in_app",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{access_token}}"
          }
        ],
        "description": "After Expert - Create Answer, the post owner should see a notification titled like پاسخ تخصصی جدید. The inbox API does not support event_type filtering."
      }
    },
    {
      "name": "Admin Notifications - Inspect Expert Answer Notifications",
      "request": {
        "method": "GET",
        "url": "{{base_url}}/admin/notifications?page=1&page_size=20&channel=in_app&recipient_user_id={{post_owner_user_id}}",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{admin_access_token}}"
          }
        ],
        "description": "Use event_id from notification detail/audit DB to verify event_type=expert_answer_created when needed; no event_type filter endpoint exists."
      }
    }
  ]
}
