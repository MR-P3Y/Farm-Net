# Non-secret values for the small public demo deployment.
# Copy to infra/demo.env on the server. Do not commit the real file.
COMPOSE_PROJECT_NAME=farmnet-demo
APP_VERSION=0.26.0-demo.1
PUBLIC_BASE_URL=https://api.farmnet.ir
ADMIN_BASE_URL=https://admin.farmnet.ir
MEDIA_BASE_URL=https://media.farmnet.ir
CORS_ORIGINS=https://farmnet.ir,https://admin.farmnet.ir
TRUSTED_PROXY_HOSTS=172.29.0.1/32
FARMNET_DEMO_SUBNET=172.29.0.0/24
BACKEND_HOST_PORT=18100
MYSQL_DATABASE=farmnet_db
MYSQL_USER=farmnet_user
SUPER_ADMIN_EMAIL=replace-with-real-admin@example.com
SUPER_ADMIN_PHONE=09121111111
