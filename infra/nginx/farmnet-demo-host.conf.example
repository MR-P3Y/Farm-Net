# Install as /etc/nginx/sites-available/farmnet-demo after replacing certificate paths.
# The existing host Nginx owns ports 80/443; Docker only exposes the API on 127.0.0.1:18100.

server {
    listen 80;
    listen [::]:80;
    server_name farmnet.ir admin.farmnet.ir api.farmnet.ir media.farmnet.ir;
    return 308 https://$host$request_uri;
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name farmnet.ir;

    ssl_certificate /etc/letsencrypt/live/farmnet.ir/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/farmnet.ir/privkey.pem;

    root /var/www/farmnet/app;
    index index.html;

    location / {
        try_files $uri $uri/ /index.html;
    }
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name admin.farmnet.ir;

    ssl_certificate /etc/letsencrypt/live/farmnet.ir/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/farmnet.ir/privkey.pem;

    root /var/www/farmnet/admin;
    index index.html;

    location / {
        try_files $uri $uri/ /index.html;
    }
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name api.farmnet.ir media.farmnet.ir;

    ssl_certificate /etc/letsencrypt/live/farmnet.ir/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/farmnet.ir/privkey.pem;

    client_max_body_size 10m;

    location = /metrics {
        return 404;
    }

    location = /ready {
        return 404;
    }

    location / {
        proxy_pass http://127.0.0.1:18100;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header Connection "";
        proxy_connect_timeout 10s;
        proxy_send_timeout 60s;
        proxy_read_timeout 60s;
        proxy_buffering off;
    }
}
