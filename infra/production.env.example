# Non-secret production topology values.
# Copy to infra/production.env (ignored), replace every example domain/value,
# and keep credentials in infra/secrets/ files.
COMPOSE_PROJECT_NAME=farmnet-production
APP_VERSION=0.26.0-dev.1
API_DOMAIN=api.farmnet.example
PUBLIC_BASE_URL=https://api.farmnet.example
ADMIN_BASE_URL=https://admin.farmnet.example
MEDIA_BASE_URL=https://api.farmnet.example/api/v1/media
CORS_ORIGINS=https://app.farmnet.example,https://admin.farmnet.example
TRUSTED_PROXY_HOSTS=172.28.0.0/24
FARMNET_EDGE_SUBNET=172.28.0.0/24
MYSQL_DATABASE=farmnet_db
MYSQL_USER=farmnet_user
SUPER_ADMIN_EMAIL=ops@farmnet.example
SUPER_ADMIN_PHONE=09121111111
WEB_PORT=80
WEB_TLS_PORT=443
TLS_CERT_DIR=/srv/farmnet/letsencrypt
WORKER_BATCH_LIMIT=50
WORKER_POLL_SECONDS=5
