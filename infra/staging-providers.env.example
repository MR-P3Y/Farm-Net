# Non-secret switches and endpoints for the credentialed staging gate.
# Keep real credentials in external files and point the matching *_FILE value
# at the mounted secret path. Never commit the populated staging environment.
APP_ENV=staging

EMAIL_ENABLED=false
EMAIL_PROVIDER=smtp
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASSWORD_FILE=
EMAIL_FROM=
EMAIL_STARTTLS=true
EMAIL_USE_SSL=false
STAGING_EMAIL_RECIPIENT=

SMS_ENABLED=false
SMS_PROVIDER=http_json
SMS_API_URL=
SMS_API_KEY_FILE=
SMS_SENDER=
STAGING_SMS_RECIPIENT=

PUSH_ENABLED=false
PUSH_PROVIDER=http_json
PUSH_API_URL=
PUSH_API_KEY_FILE=
STAGING_PUSH_TOKEN=

PAYMENT_GATEWAY_ENABLED=false
PAYMENT_GATEWAY=zarinpal
PAYMENT_MERCHANT_ID_FILE=
PAYMENT_CALLBACK_BASE_URL=
PAYMENT_ZARINPAL_SANDBOX=true
